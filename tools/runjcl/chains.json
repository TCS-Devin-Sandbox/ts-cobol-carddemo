    "inputs": {
      "DYNSQL": 80,
      "INPFILE": 53
    },
    "setup": [],
    "jobs": [
      "MNTTRDYN"
    ],
    "outputs": {},
    "sysout": [
      "MNTTRDYN/STEP1"
    ],
    "database": {
      "seed": "db/seed.sql",
      "tables": {
        "carddemo.transaction_type": "tr_type",
        "carddemo.transaction_type_categor": "trc_type_code, trc_type_category"
      }
    }
  }
}
